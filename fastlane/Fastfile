default_platform(:ios)

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do
    # 1. Authenticate via App Store Connect API Key
    api_key = app_store_connect_api_key(
      key_id: ENV["KEY_ID"],
      issuer_id: ENV["ISSUER_ID"],
      key_content: ENV["KEY_CONTENT"],
      is_key_content_base64: false,
      in_house: false
    )

    # 2. Define the exact path to the temporary keychain file
    keychain_name = "fastlane_tmp_keychain"
    keychain_db = File.expand_path("~/Library/Keychains/#{keychain_name}-db")
    keychain_password = "glovebox_build_temp"

    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    # 3. Explicitly install the certificate and private key into the temporary keychain
    get_certificates(
      api_key: api_key,
      keychain_path: keychain_db,
      keychain_password: keychain_password
    )

    # 4. Fetch the provisioning profile
    profile = get_provisioning_profile(
      app_identifier: ENV["BUNDLE_ID"],
      api_key: api_key
    )

    # 5. Tell the Xcode project to use manual signing with the downloaded profile
    update_code_signing_settings(
      path: "ios/App/App.xcodeproj",
      use_automatic_signing: false,
      team_id: ENV["ISSUER_ID"],
      bundle_identifier: ENV["BUNDLE_ID"],
      code_sign_identity: "Apple Distribution",
      profile_name: ENV["SIGH_NAME"]
    )

    # 6. Compile the archive
    build_app(
      workspace: "ios/App/App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          ENV["BUNDLE_ID"] => ENV["SIGH_NAME"]
        }
      }
    )

    # 7. Upload to TestFlight
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
