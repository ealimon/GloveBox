default_platform(:ios)

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do
    # 1. Connect to App Store Connect API
    api_key = app_store_connect_api_key(
      key_id: ENV["KEY_ID"],
      issuer_id: ENV["ISSUER_ID"],
      key_content: ENV["KEY_CONTENT"],
      is_key_content_base64: false,
      in_house: false
    )

    # 2. Set up and configure temporary keychain
    keychain_name = "fastlane_tmp_keychain"
    keychain_path = File.expand_path("~/Library/Keychains/#{keychain_name}-db")
    keychain_password = "glovebox_build_temp"

    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    # Ensure the keychain is in the active search list
    sh("security list-keychains -d user -s #{keychain_path} $(security list-keychains -d user | tr -d '\"')")

    # 3. Decode and import the distribution certificate
    sh("echo \"$DISTRIBUTION_P12_BASE64\" | base64 --decode > /tmp/dist_cert.p12")
    import_certificate(
      keychain_name: keychain_name,
      keychain_password: keychain_password,
      certificate_path: "/tmp/dist_cert.p12",
      certificate_password: ENV["DISTRIBUTION_P12_PASSWORD"]
    )

    # 4. Fetch the matching provisioning profile
    get_provisioning_profile(
      app_identifier: ENV["BUNDLE_ID"],
      api_key: api_key
    )

    # 5. Build and sign the IPA
    build_app(
      workspace: "ios/App/App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      xcargs: "CODE_SIGN_STYLE=Manual PROVISIONING_PROFILE_SPECIFIER='#{ENV["SIGH_NAME"]}' CODE_SIGN_IDENTITY='Apple Distribution'",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          ENV["BUNDLE_ID"] => ENV["SIGH_NAME"]
        }
      }
    )

    # 6. Upload directly to TestFlight
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
