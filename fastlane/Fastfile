default_platform(:ios)

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do
    # 1. Connect to App Store Connect API
    api_key = app_store_connect_api_key(
      key_id: ENV["KEY_ID"],
      issuer_id: ENV["ISSUER_ID"],
      key_content: ENV["KEY_CONTENT"],
      is_key_content_base64: false,
      in_house: false
    )

    # 2. Configure temporary keychain
    keychain_name = "fastlane_tmp_keychain"
    keychain_path = File.expand_path("~/Library/Keychains/#{keychain_name}-db")
    keychain_password = "glovebox_build_temp"

    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    # Decode the P12 file
    sh("echo \"$DISTRIBUTION_P12_BASE64\" | base64 --decode > /tmp/dist_cert.p12")

    # Native macOS security import into custom keychain
    sh("security import /tmp/dist_cert.p12 -k #{keychain_path} -P '#{ENV["DISTRIBUTION_P12_PASSWORD"]}' -T /usr/bin/codesign -T /usr/bin/security")
    sh("security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k #{keychain_password} #{keychain_path}")
    sh("security list-keychains -d user -s #{keychain_path} $(security list-keychains -d user | tr -d '\"')")

    # 3. Fetch matching provisioning profile
    profile_name = get_provisioning_profile(
      app_identifier: ENV["BUNDLE_ID"],
      api_key: api_key
    )

    # 4. Build and sign the IPA archive
    build_app(
      workspace: "ios/App/App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      xcargs: "CODE_SIGN_STYLE=Manual PROVISIONING_PROFILE_SPECIFIER='#{lane_context[SharedValues::SIGH_UUID]}' CODE_SIGN_IDENTITY='Apple Distribution'",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          ENV["BUNDLE_ID"] => lane_context[SharedValues::SIGH_NAME] || lane_context[SharedValues::SIGH_UUID]
        }
      }
    )

    # 5. Upload directly to TestFlight
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
