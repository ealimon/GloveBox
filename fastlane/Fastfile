default_platform(:ios)

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do
    # 1. Authenticate via App Store Connect API Key
    api_key = app_store_connect_api_key(
      key_id: ENV["KEY_ID"],
      issuer_id: ENV["ISSUER_ID"],
      key_content: ENV["KEY_CONTENT"],
      is_key_content_base64: false,
      in_house: false
    )

    # 2. Set up an explicit, unlocked temporary keychain
    create_keychain(
      name: "fastlane_tmp_keychain",
      password: "glovebox_build_temp",
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    # 3. Retrieve or create certificate (automatically uses the default temp keychain)
    get_certificates(
      api_key: api_key
    )

    # 4. Fetch App Store Provisioning Profile
    get_provisioning_profile(
      app_identifier: ENV["BUNDLE_ID"],
      api_key: api_key
    )

    # 5. Compile the iOS app archive (.ipa)
    build_app(
      workspace: "ios/App/App.xcworkspace",
      scheme: "App",
      export_method: "app-store"
    )

    # 6. Upload directly to TestFlight
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
