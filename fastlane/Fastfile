default_platform(:ios)

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do
    # Authenticate via App Store Connect API Key
    api_key = app_store_connect_api_key(
      key_id: ENV["KEY_ID"],
      issuer_id: ENV["ISSUER_ID"],
      key_content: ENV["KEY_CONTENT"],
      is_key_content_base64: false,
      in_house: false
    )

    # Create and unlock a temporary keychain for the runner
    keychain_name = "fastlane_tmp_keychain"
    keychain_password = "glovebox_build_temp"

    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeping: false
    )

    # Download or generate Apple Distribution certificate and store in this keychain
    get_certificates(
      api_key: api_key,
      keychain_path: keychain_name,
      keychain_password: keychain_password
    )

    # Download or generate App Store Provisioning Profile
    get_provisioning_profile(
      app_identifier: ENV["BUNDLE_ID"],
      api_key: api_key
    )

    # Build the iOS app package (.ipa)
    build_app(
      workspace: "ios/App/App.xcworkspace",
      scheme: "App",
      export_method: "app-store"
    )

    # Upload to TestFlight
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
