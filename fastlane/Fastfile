default_platform(:ios)

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do
    # Authenticate via App Store Connect API Key
    api_key = app_store_connect_api_key(
      key_id: ENV["KEY_ID"],
      issuer_id: ENV["ISSUER_ID"],
      key_content: ENV["KEY_CONTENT"],
      is_key_content_base64: false,
      in_house: false
    )

    # Automatically creates and unlocks a dedicated temporary CI keychain
    keychain_path = setup_ci if ENV["CI"]

    # Download or generate certificate into the unlocked CI keychain
    get_certificates(
      api_key: api_key,
      keychain_path: keychain_path
    )

    # Download or generate provisioning profile
    get_provisioning_profile(
      app_identifier: ENV["BUNDLE_ID"],
      api_key: api_key
    )

    # Build the iOS app package (.ipa)
    build_app(
      workspace: "ios/App/App.xcworkspace",
      scheme: "App",
      export_method: "app-store"
    )

    # Upload directly to TestFlight
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
