default_platform(:ios)

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do
    # 1. Authenticate via App Store Connect API Key
    api_key = app_store_connect_api_key(
      key_id: ENV["KEY_ID"],
      issuer_id: ENV["ISSUER_ID"],
      key_content: ENV["KEY_CONTENT"],
      is_key_content_base64: false,
      in_house: false
    )

    # 2. Define the exact path to the temporary keychain file
    keychain_name = "fastlane_tmp_keychain"
    keychain_db = File.expand_path("~/Library/Keychains/#{keychain_name}-db")
    keychain_password = "glovebox_build_temp"

    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    # 3. Explicitly install the certificate into the temporary keychain
    get_certificates(
      api_key: api_key,
      keychain_path: keychain_db,
      keychain_password: keychain_password
    )

    # 4. Force regenerate profile to pair with the newly installed certificate
    get_provisioning_profile(
      app_identifier: ENV["BUNDLE_ID"],
      api_key: api_key,
      force: true
    )

    # 5. Compile the archive with manual signing injected into xcodebuild
    build_app(
      workspace: "ios/App/App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      xcargs: "CODE_SIGN_STYLE=Manual PROVISIONING_PROFILE_SPECIFIER='#{ENV["SIGH_NAME"]}' CODE_SIGN_IDENTITY='Apple Distribution'",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          ENV["BUNDLE_ID"] => ENV["SIGH_NAME"]
        }
      }
    )

    # 6. Upload directly to TestFlight
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
