default_platform(:ios)

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do
    # 1. Decode P8 App Store Connect API Key to disk
    sh("echo \"$KEY_CONTENT\" | base64 --decode > /tmp/AuthKey.p8")

    app_store_connect_api_key(
      key_id: ENV["KEY_ID"],
      issuer_id: ENV["ISSUER_ID"],
      key_filepath: "/tmp/AuthKey.p8",
      in_house: false
    )

    # 2. Setup temporary keychain for CI
    create_keychain(
      name: "temporary_keychain",
      password: "temporary_password",
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    # 3. Decode & import distribution certificate
    sh("echo \"$DISTRIBUTION_P12_BASE64\" | base64 --decode > /tmp/dist_cert.p12")
    import_certificate(
      keychain_name: "temporary_keychain",
      keychain_password: "temporary_password",
      certificate_path: "/tmp/dist_cert.p12",
      certificate_password: ENV["DISTRIBUTION_P12_PASSWORD"]
    )

    sh("security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k temporary_password temporary_keychain")
    sh("security list-keychains -d user -s /Users/runner/Library/Keychains/temporary_keychain-db $(security list-keychains -d user | tr -d '\"')")

    # 4. Fetch the provisioning profile
    get_provisioning_profile(
      app_identifier: ENV["BUNDLE_ID"],
      output_path: "/tmp"
    )

    # 5. Build and package the archive
    build_app(
      workspace: "ios/App/App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          ENV["BUNDLE_ID"] => lane_context[SharedValues::SIGH_NAME] || lane_context[SharedValues::SIGH_UUID]
        }
      }
    )

    # 6. Upload directly to TestFlight
    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )
  end
end
