default_platform(:ios)

platform :ios do
  desc "Generate and bundle a permanent distribution certificate"
  lane :generate_p12 do
    api_key = app_store_connect_api_key(
      key_id: ENV["KEY_ID"],
      issuer_id: ENV["ISSUER_ID"],
      key_content: ENV["KEY_CONTENT"],
      is_key_content_base64: false,
      in_house: false
    )

    keychain_name = "fastlane_tmp_keychain"
    keychain_password = "glovebox_build_temp"

    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    # 1. Generate or fetch certificate
    get_certificates(
      api_key: api_key
    )

    # 2. Export the installed certificate + private key into a .p12
    p12_path = File.expand_path("~/Desktop/dist_cert.p12")
    p12_password = "GloveBoxPassword123!"

    sh("security export -k ~/Library/Keychains/#{keychain_name}-db -t all -f pkcs12 -P '#{p12_password}' -o #{p12_path}")

    # 3. Print the base64 string directly in the log
    sh("base64 -i #{p12_path} > /tmp/cert_base64.txt")
    puts "--- COPY EVERYTHING BETWEEN THESE LINES ---"
    puts File.read("/tmp/cert_base64.txt")
    puts "--- END OF CERTIFICATE BASE64 ---"
  end
end
